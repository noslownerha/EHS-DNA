[Unit]
Description=EHS DNA application server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ehs-platform
Environment=PORT=3000
Environment=NODE_ENV=production
# Set once during setup: systemctl edit ehs-dna  →  [Service] Environment=EHS_JWT_SECRET=<random hex>
EnvironmentFile=-/etc/ehs-dna.env
ExecStart=/usr/bin/node server/index.cjs
Restart=always
RestartSec=3
StandardOutput=append:/var/log/ehs-dna.log
StandardError=append:/var/log/ehs-dna.log

# ── Process hardening ──
# NB: the app + SQLite DB live under /home/ehs-platform, so ProtectHome is
# deliberately NOT set — it would block DB writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
