[Unit]
Description=EHS DNA — STAGING (test copy)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ehs-staging
Environment=PORT=3002
Environment=NODE_ENV=production
# Own secret, own database, own photos, email OFF — see /etc/ehs-dna-staging.env
EnvironmentFile=/etc/ehs-dna-staging.env
ExecStart=/usr/bin/node server/index.cjs
Restart=always
RestartSec=3
StandardOutput=append:/var/log/ehs-dna-staging.log
StandardError=append:/var/log/ehs-dna-staging.log
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
